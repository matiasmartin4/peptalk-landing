{
  "$description": "peptalk design tokens. Formato W3C Design Tokens (DTCG). Fuente única: tokens.css y tailwind.preset.js se generan desde acá con scripts/build.py.",

  "color": {
    "$type": "color",
    "brand": {
      "orange":       { "$value": "#FF6A00", "$description": "Naranja principal. Fondos, botones, acentos. No usar para texto chico sobre claro (contraste 2,9)." },
      "orange-light": { "$value": "#FFB066", "$description": "Naranja claro. Acentos sobre oscuro, gráficos." },
      "amber":        { "$value": "#FFD8AB", "$description": "Ámbar. Bordes cálidos, fondos de chips." },
      "cream":        { "$value": "#FFF7EF", "$description": "Crema. Fondos de marca y superficies cálidas." },
      "ink":          { "$value": "#1A1A1A", "$description": "Gris oscuro. Texto principal y fondos oscuros." },
      "gray":         { "$value": "#6B6B6B", "$description": "Gris medio. Texto secundario (AA sobre crema y blanco)." }
    },
    "support": {
      "rust":     { "$value": "#B34700", "$description": "Naranja para texto y links sobre fondos claros (AA)." },
      "paper":    { "$value": "#FCFBF9", "$description": "Fondo de página." },
      "white":    { "$value": "#FFFFFF" },
      "sand":     { "$value": "#F3EDE5" },
      "line":     { "$value": "#ECE6DE" },
      "ink-soft": { "$value": "#4D4D4D" },
      "night":    { "$value": "#0E0B0A", "$description": "Negro cálido de los fondos de marca oscuros." },
      "night-2":  { "$value": "#1F1A17" }
    },
    "status": {
      "approved":      { "$value": "{color.brand.ink}" },
      "investigation": { "$value": "{color.brand.orange-light}" },
      "prohibited":    { "$value": "{color.brand.orange}" },
      "cosmetic":      { "$value": "{color.brand.amber}" },
      "unlisted":      { "$value": "#C8C8C8" },
      "pending":       { "$value": "#8F8F8F" },
      "error":         { "$value": "#C2410C" },
      "success":       { "$value": "#2F9E44" }
    },
    "evidence": {
      "A": { "$value": "{color.brand.ink}" },
      "B": { "$value": "{color.support.rust}" },
      "C": { "$value": "{color.brand.orange}" },
      "D": { "$value": "{color.brand.orange-light}" },
      "E": { "$value": "{color.brand.amber}" },
      "none": { "$value": "{color.support.sand}" }
    }
  },

  "gradient": {
    "$type": "gradient",
    "isotipo":  { "$value": [{ "color": "#FFC66B", "position": 0 }, { "color": "#FF8A1F", "position": 0.45 }, { "color": "#FF5A00", "position": 0.8 }, { "color": "#E63B00", "position": 1 }], "$description": "Relleno del isotipo, de arriba a la derecha hacia abajo a la izquierda." },
    "sphere":   { "$value": [{ "color": "#FFB066", "position": 0 }, { "color": "#FF8F4A", "position": 0.4 }, { "color": "#C9A9A6", "position": 1 }], "$description": "Esfera del isotipo: naranja arriba, gris lavanda abajo." },
    "text":     { "$value": [{ "color": "#B34700", "position": 0 }, { "color": "#FF6A00", "position": 0.6 }, { "color": "#FF8A33", "position": 1 }], "$description": "Texto destacado en titulares." },
    "glow":     { "$value": [{ "color": "#FFB066", "position": 0 }, { "color": "#FFD8AB", "position": 0.55 }, { "color": "#FFD8AB00", "position": 1 }] }
  },

  "font": {
    "family": {
      "$type": "fontFamily",
      "sans": { "$value": ["Inter", "system-ui", "-apple-system", "Segoe UI", "sans-serif"] }
    },
    "weight": {
      "$type": "fontWeight",
      "regular":   { "$value": 400 },
      "medium":    { "$value": 500 },
      "semibold":  { "$value": 600 },
      "bold":      { "$value": 700 },
      "extrabold": { "$value": 800, "$description": "Solo titulares grandes y logotipo." }
    },
    "size": {
      "$type": "dimension",
      "xs":   { "$value": "12px" },
      "sm":   { "$value": "13px" },
      "md":   { "$value": "14px" },
      "base": { "$value": "16px" },
      "lg":   { "$value": "18px" },
      "xl":   { "$value": "20px" },
      "2xl":  { "$value": "24px" },
      "3xl":  { "$value": "32px" },
      "4xl":  { "$value": "44px" },
      "5xl":  { "$value": "56px" },
      "6xl":  { "$value": "68px" }
    },
    "leading": {
      "$type": "number",
      "tight": { "$value": 1.02 },
      "heading": { "$value": 1.1 },
      "snug": { "$value": 1.3 },
      "body": { "$value": 1.55 }
    },
    "tracking": {
      "$type": "dimension",
      "display": { "$value": "-0.04em" },
      "heading": { "$value": "-0.025em" },
      "body":    { "$value": "0em" },
      "eyebrow": { "$value": "0.12em" }
    }
  },

  "space": {
    "$type": "dimension",
    "1":  { "$value": "4px" },
    "2":  { "$value": "8px" },
    "3":  { "$value": "12px" },
    "4":  { "$value": "16px" },
    "5":  { "$value": "20px" },
    "6":  { "$value": "24px" },
    "8":  { "$value": "32px" },
    "10": { "$value": "40px" },
    "12": { "$value": "48px" },
    "16": { "$value": "64px" },
    "20": { "$value": "80px" },
    "26": { "$value": "104px" },
    "30": { "$value": "120px" }
  },

  "radius": {
    "$type": "dimension",
    "sm":   { "$value": "10px" },
    "md":   { "$value": "16px" },
    "lg":   { "$value": "24px" },
    "xl":   { "$value": "32px" },
    "pill": { "$value": "999px" },
    "icon": { "$value": "22.5%", "$description": "Ícono de app: cuadrado con esquinas al 22,5% del lado." }
  },

  "shadow": {
    "$type": "shadow",
    "sm":   { "$value": "0 1px 2px rgba(26,26,26,.04), 0 4px 14px rgba(26,26,26,.05)" },
    "lg":   { "$value": "0 18px 48px rgba(26,26,26,.10)" },
    "glow": { "$value": "0 30px 60px rgba(255,106,0,.28)" },
    "focus": { "$value": "0 0 0 4px rgba(255,106,0,.14)" }
  },

  "motion": {
    "ease":     { "$type": "cubicBezier", "$value": [0.2, 0.7, 0.2, 1] },
    "fast":     { "$type": "duration", "$value": "150ms" },
    "base":     { "$type": "duration", "$value": "200ms" },
    "slow":     { "$type": "duration", "$value": "350ms" }
  },

  "layout": {
    "$type": "dimension",
    "container": { "$value": "1200px" },
    "nav-height": { "$value": "68px" },
    "control-height": { "$value": "44px" }
  },

  "logo": {
    "clearspace": { "$type": "number", "$value": 0.36, "$description": "Área de respeto alrededor del logo = diámetro de la esfera del isotipo (0,36 × alto del isotipo)." },
    "min-width-logo": { "$type": "dimension", "$value": "96px", "$description": "Ancho mínimo del logo completo en pantalla." },
    "min-size-isotipo": { "$type": "dimension", "$value": "20px", "$description": "Tamaño mínimo del isotipo solo (favicon)." }
  }
}
