{
  "name": "peptalk-react",
  "private": true,
  "description": "Piezas en React del sitio (se compilan a react/dist; el sitio sigue siendo est\u00e1tico).",
  "scripts": {
    "build": "esbuild src/hero.tsx src/lab/cards.tsx --bundle --minify --format=iife --target=es2019 --jsx=automatic --define:process.env.NODE_ENV=\\\"production\\\" --outdir=dist --entry-names=[name]",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2"
  }
}
